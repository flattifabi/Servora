<Project Sdk="Microsoft.NET.Sdk">
  <!-- PostgreSQL database provider (Npgsql) and its EF Core migrations. -->
  <PropertyGroup>
    <RootNamespace>Servora.Persistence.PostgreSql</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Servora.Infrastructure\Servora.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
</Project>
