@page "/portal"
@* Portal home: mint hero with greeting, headline, search and frequently searched terms next to the hero image; category
   cards; frequently used services; the user's latest requests and the support card. Texts and the hero image come
   from the portal settings. *@
@attribute [RequirePermission(Permissions.Portal.Access)]
@inject IPortalHomeService Home
@inject IPortalSettingsService PortalSettings
@inject ICatalogOrderService Catalog
@inject ICurrentUser CurrentUser
@inject ToastService Toasts

<PageTitle>Service portal · @Brand.ProductName</PageTitle>

<section class="ph-hero">
    <div class="portal-container ph-hero-inner">
        <div class="ph-hero-text">
            @if (!string.IsNullOrWhiteSpace(_settings?.HeroGreeting))
            {
                <div class="ph-greeting">@_settings.GreetingFor(PortalFormat.FirstName(CurrentUser.DisplayName))</div>
            }
            <h1 class="ph-title">@(_settings?.HeroTitle ?? "Good work starts here.")</h1>
            @if (!string.IsNullOrWhiteSpace(_settings?.HeroSubtitle))
            {
                <p class="ph-sub">@_settings.HeroSubtitle</p>
            }
            <div class="ph-search">
                <PortalSearchBox Large="true" Placeholder="@(_settings?.SearchPlaceholder is { Length: > 0 } placeholder ? placeholder : "What do you need? Search for services, software and more …")" Currency="@Currency" />
            </div>
            @if (_settings?.FrequentSearchTerms is { Count: > 0 } terms)
            {
                <div class="ph-frequent">
                    <span>Frequently searched</span>
                    @foreach (var term in terms)
                    {
                        <a href="/portal/search?q=@Uri.EscapeDataString(term)">@term <Icon Name="arrow-up-right" Size="12" /></a>
                    }
                </div>
            }
        </div>
        <div class="ph-visual">
            <div class="ph-visual-card">
                @if (_settings?.HeroImageUrl is { } hero)
                {
                    <img src="@hero" alt="" />
                }
                else
                {
                    <PortalHeroIllustration />
                }
                @if (!string.IsNullOrWhiteSpace(_settings?.HeroImageCaption))
                {
                    <span class="ph-caption"><PortalGlyph Name="sparkle" Size="13" /> @_settings.HeroImageCaption</span>
                }
            </div>
        </div>
    </div>
</section>

<div class="portal-container">
    @if (_data is null)
    {
        <div class="ph-section">
            <div class="ph-cats">
                @for (var i = 0; i < 4; i++)
                {
                    <div class="pcard" style="padding:18px"><Skeleton Lines="3" /></div>
                }
            </div>
        </div>
    }
    else
    {
        @if (_data.Announcements.Count > 0)
        {
            <div class="ph-announcements">
                @foreach (var announcement in _data.Announcements)
                {
                    <PortalAnnouncementBanner @key="announcement.Id" Announcement="announcement" />
                }
            </div>
        }

        @if (_data.Categories.Count > 0)
        {
            <section class="ph-section" aria-labelledby="ph-cats-title">
                <div class="psection-head">
                    <h2 id="ph-cats-title">What do you need today?</h2>
                    <a class="psection-link" href="/portal/catalog">All @_data.TotalServices services <Icon Name="arrow-right" Size="14" /></a>
                </div>
                <div class="ph-cats">
                    @foreach (var category in _data.Categories.Take(_data.Categories.Count >= 8 ? 8 : 4))
                    {
                        <PortalCategoryCard @key="category.Id" Category="category" />
                    }
                </div>
            </section>
        }

        @if (_data.SpotlightItems.Count > 0)
        {
            <section class="ph-section" aria-labelledby="ph-spot-title">
                <div class="psection-head">
                    <div>
                        <h2 id="ph-spot-title">Frequently used. Quickly found.</h2>
                        <p>The most popular services among your colleagues.</p>
                    </div>
                    <a class="psection-link" href="/portal/catalog">Discover all services <Icon Name="arrow-right" Size="14" /></a>
                </div>
                <div class="ph-spot">
                    @foreach (var item in _data.SpotlightItems)
                    {
                        <PortalSpotlightCard @key="item.Id" Item="item" Currency="@Currency" IsFavorite="_favorites.Contains(item.Id)"
                                             IsMostOrdered="item.Id == _data.MostOrderedItemId" OnToggleFavorite="ToggleFavoriteAsync" />
                    }
                </div>
            </section>
        }

        <section class="ph-section ph-bottom">
            <PortalRequestTable Items="_data.LatestItems" OpenCount="_data.OpenRequests + _data.OpenIncidents" />
            @if (_settings is not null)
            {
                <PortalSupportCard Settings="_settings" />
            }
        </section>
    }
</div>

@code {
    private PortalHomeData? _data;
    private PortalSettingsModel? _settings;
    private HashSet<Guid> _favorites = [];

    private string Currency => _settings?.Currency ?? "EUR";

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _settings = (await PortalSettings.GetAsync()).Value;
        var result = await Home.GetHomeAsync();
        if (result.Succeeded)
        {
            _data = result.Value;
            _favorites = [.. _data!.FavoriteIds];
        }
        else
        {
            _data = new PortalHomeData();
            Toasts.Error("The portal could not be loaded", result.Error);
        }
    }

    private async Task ToggleFavoriteAsync(CatalogItemCard item)
    {
        var add = !_favorites.Contains(item.Id);
        var result = await Catalog.SetFavoriteAsync(item.Id, add);
        if (Toasts.FromResult(result, add ? $"{item.Name} saved to your favourites" : $"{item.Name} removed from your favourites"))
        {
            if (add)
            {
                _favorites.Add(item.Id);
            }
            else
            {
                _favorites.Remove(item.Id);
            }
        }
    }
}
