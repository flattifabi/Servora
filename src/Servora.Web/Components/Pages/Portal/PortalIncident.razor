@page "/portal/incidents/{Id:guid}"
@* One of the user's issues (incidents): status timeline, resolution confirmation (accept / reopen), description, public
   conversation with attachments and key facts. Ownership is enforced by IPortalTicketService. *@
@attribute [RequirePermission(Permissions.Portal.Access)]
@inject IPortalTicketService Tickets
@inject ToastService Toasts

<PageTitle>@(_detail?.Number ?? "Issue") · Servora</PageTitle>

<div class="portal-container">
    @if (_loading)
    {
        <div class="portal-page-head"><Skeleton Lines="2" Height="22px" /></div>
        <div class="card card-body"><Skeleton Lines="5" /></div>
    }
    else if (_detail is null)
    {
        <div class="portal-page-head"></div>
        <div class="card">
            <EmptyState Icon="search" Title="Issue not found" Text="This issue does not exist or does not belong to you.">
                <a class="btn btn-primary" href="/portal/my"><Icon Name="inbox" Size="16" /> Go to my items</a>
            </EmptyState>
        </div>
    }
    else
    {
        <div class="portal-page-head">
            <div class="portal-crumbs">
                <a href="/portal">Portal</a> <Icon Name="chevron-right" Size="12" />
                <a href="/portal/my">My items</a> <Icon Name="chevron-right" Size="12" />
                <span class="mono">@_detail.Number</span>
            </div>
            <div class="flex items-center gap-2 flex-wrap mt-3">
                <span class="tag mono">@_detail.Number</span>
                <StatusPill Text="@_detail.Status.Label" Tone="@_detail.Status.Tone" />
            </div>
            <h1>@_detail.Title</h1>
            <p>Reported <RelativeTime Value="_detail.OpenedAt" /> · last update <RelativeTime Value="_detail.UpdatedAt" /></p>
        </div>

        @if (_detail.CanAcceptResolution)
        {
            <div class="pinc-resolved">
                <div class="pinc-resolved-icon"><Icon Name="check-circle" Size="24" /></div>
                <div class="flex-1" style="min-width:0">
                    <div class="pinc-resolved-title">We think this is solved – is everything working again?</div>
                    @if (!string.IsNullOrWhiteSpace(_detail.ResolutionNotes))
                    {
                        <div class="pinc-resolved-notes">@_detail.ResolutionNotes</div>
                    }
                </div>
                <div class="flex gap-2 flex-wrap pinc-resolved-actions">
                    <button class="btn btn-success" disabled="@_busy" @onclick="AcceptAsync"><Icon Name="thumbs-up" Size="16" /> Yes, it's solved</button>
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="() => _reopenOpen = true"><Icon Name="refresh" Size="16" /> No, still a problem</button>
                </div>
            </div>
        }
        else if (_detail.Status.NeedsAction)
        {
            <div class="alert alert-warning mb-4"><Icon Name="message-circle" Size="16" /><span>The support team is waiting for your reply – please answer in the conversation below.</span></div>
        }

        <div class="card card-body mb-6">
            <PortalStatusTimeline Steps="_detail.Steps" />
        </div>

        <div class="portal-two-col">
            <div class="stack" style="min-width:0">
                <div class="card">
                    <div class="card-header"><h3 style="margin:0;font-size:15px">Description</h3></div>
                    <div class="card-body">
                        @if (string.IsNullOrWhiteSpace(_detail.Description))
                        {
                            <span class="small faint">No details were given.</span>
                        }
                        else
                        {
                            <div class="pinc-text">@_detail.Description</div>
                        }
                    </div>
                </div>

                @if (_detail.ResolutionNotes is not null && !_detail.CanAcceptResolution)
                {
                    <div class="card">
                        <div class="card-header"><h3 style="margin:0;font-size:15px">Solution</h3>@if (_detail.ResolutionLabel is not null)
                        {
                            <span class="tag">@_detail.ResolutionLabel</span>
                        }</div>
                        <div class="card-body"><div class="pinc-text">@_detail.ResolutionNotes</div></div>
                    </div>
                }

                <PortalConversationPanel @ref="_conversation" Kind="PortalTicketKind.Incident" RecordId="_detail.Id" OnChanged="RefreshAsync" />
            </div>

            <div class="portal-sticky stack" style="gap:16px">
                <div class="card card-body">
                    <div class="eyebrow mb-3">Details</div>
                    <dl class="portal-facts">
                        @foreach (var fact in _detail.Facts)
                        {
                            <dt>@fact.Label</dt><dd>@(fact.Value ?? "—")</dd>
                        }
                        <dt>Reported</dt><dd>@PortalFormat.Date(_detail.OpenedAt)</dd>
                        @if (_detail.ResolvedAt is not null)
                        {
                            <dt>Resolved</dt><dd>@PortalFormat.Date(_detail.ResolvedAt)</dd>
                        }
                        @if (_detail.ClosedAt is not null)
                        {
                            <dt>Closed</dt><dd>@PortalFormat.Date(_detail.ClosedAt)</dd>
                        }
                    </dl>
                </div>
                <div class="card card-body">
                    <div class="eyebrow mb-3">Who is helping</div>
                    @if (_detail.AssignmentGroupName is null && _detail.AssignedToName is null)
                    {
                        <div class="small muted">The service desk will assign your issue shortly.</div>
                    }
                    else
                    {
                        <div class="stack" style="gap:12px">
                            @if (_detail.AssignedToName is not null)
                            {
                                <div class="person"><Avatar Name="@_detail.AssignedToName" /> <div><div style="font-weight:600">@_detail.AssignedToName</div><div class="tiny faint">Support specialist</div></div></div>
                            }
                            @if (_detail.AssignmentGroupName is not null)
                            {
                                <div class="person"><span class="portal-icon-tile" style="width:32px;height:32px;border-radius:10px"><Icon Name="users" Size="16" /></span> <div><div style="font-weight:600">@_detail.AssignmentGroupName</div><div class="tiny faint">Team</div></div></div>
                            }
                        </div>
                    }
                    @if (_detail.CallerName is not null && _detail.OpenedByName is not null && _detail.CallerName != _detail.OpenedByName)
                    {
                        <div class="small faint mt-4">Reported by @_detail.OpenedByName for @_detail.CallerName.</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<Modal @bind-Open="_reopenOpen" Title="Still not working?" Subtitle="Tell us what is still wrong – the team will continue working on it." Icon="refresh">
    <ChildContent>
        <FormField Label="What is still not working?" Required="true" Error="@_reopenError">
            <textarea class="textarea" rows="4" maxlength="2000" @bind="_reopenReason" @bind:event="oninput" placeholder="For example: the error still appears when I open the app."></textarea>
        </FormField>
    </ChildContent>
    <Footer>
        <button class="btn btn-secondary" @onclick="() => _reopenOpen = false">Cancel</button>
        <button class="btn btn-primary" disabled="@_busy" @onclick="ReopenAsync">
            @if (_busy)
            {
                <span class="spinner"></span>
            }
            Reopen issue
        </button>
    </Footer>
</Modal>

@code {
    private PortalIncidentDetail? _detail;
    private PortalConversationPanel? _conversation;
    private bool _loading = true;
    private bool _busy;
    private bool _reopenOpen;
    private string _reopenReason = string.Empty;
    private string? _reopenError;

    /// <summary>Gets or sets the incident identifier.</summary>
    [Parameter] public Guid Id { get; set; }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        var result = await Tickets.GetIncidentAsync(Id);
        _detail = result.Succeeded ? result.Value : null;
    }

    private async Task RefreshAsync() => await LoadAsync();

    private async Task AcceptAsync()
    {
        _busy = true;
        try
        {
            var result = await Tickets.AcceptResolutionAsync(Id);
            if (Toasts.FromResult(result, "Thanks for confirming – the issue is closed"))
            {
                await LoadAsync();
                if (_conversation is not null)
                {
                    await _conversation.ReloadAsync();
                }
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReopenAsync()
    {
        _reopenError = string.IsNullOrWhiteSpace(_reopenReason) ? "Please tell us what is still wrong." : null;
        if (_reopenError is not null)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Tickets.ReopenIncidentAsync(Id, _reopenReason);
            if (Toasts.FromResult(result, "The issue was reopened"))
            {
                _reopenOpen = false;
                _reopenReason = string.Empty;
                await LoadAsync();
                if (_conversation is not null)
                {
                    await _conversation.ReloadAsync();
                }
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
