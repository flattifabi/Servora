<Project Sdk="Microsoft.NET.Sdk">
  <!-- SQLite database provider and its EF Core migrations. -->
  <PropertyGroup>
    <RootNamespace>Servora.Persistence.Sqlite</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Servora.Infrastructure\Servora.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
</Project>
