@* Reference picker for groups (sys_user_group). *@
@using Servora.Application.Directory
@inject IDirectoryLookupService Lookup

<ReferencePicker Value="Value" ValueChanged="ValueChanged" Search="SearchAsync" Resolve="ResolveAsync"
                 Placeholder="@Placeholder" Icon="users" Disabled="Disabled" Required="Required" />

@code {
    /// <summary>Gets or sets the selected group id.</summary>
    [Parameter] public Guid? Value { get; set; }

    /// <summary>Raised when the selection changes.</summary>
    [Parameter] public EventCallback<Guid?> ValueChanged { get; set; }

    /// <summary>Gets or sets the placeholder.</summary>
    [Parameter] public string Placeholder { get; set; } = "Search groups…";

    /// <summary>Gets or sets a value indicating whether the picker is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Gets or sets a value indicating whether a value is required.</summary>
    [Parameter] public bool Required { get; set; }

    private Task<IReadOnlyList<LookupItem>> SearchAsync(string? term) => Lookup.SearchGroupsAsync(term, 10);

    private async Task<LookupItem?> ResolveAsync(Guid id) => (await Lookup.GetGroupsAsync([id])).GetValueOrDefault(id);
}
