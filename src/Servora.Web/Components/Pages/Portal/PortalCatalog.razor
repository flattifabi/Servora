@page "/portal/catalog"
@* Service catalog browsing: search, category chips and item cards (data from ICatalogOrderService). *@
@attribute [RequirePermission(Permissions.Portal.Access)]
@implements IDisposable
@inject ICatalogOrderService Catalog
@inject NavigationManager Navigation
@inject ToastService Toasts

<PageTitle>Service catalog · Servora</PageTitle>

<div class="portal-container">
    <div class="portal-page-head">
        <div class="portal-crumbs"><a href="/portal">Portal</a> <Icon Name="chevron-right" Size="12" /> <span>Catalog</span></div>
        <h1>What do you need?</h1>
        <p>Order hardware, software, access and services. Approvals and delivery are handled for you – track everything under My items.</p>
    </div>

    <div class="pcatalog-toolbar">
        <div class="input-icon pcatalog-search">
            <Icon Name="search" Size="16" />
            <input class="input" type="search" placeholder="Search the catalog…" value="@_search" maxlength="100" @oninput="OnSearchInputAsync" aria-label="Search the catalog" />
        </div>
        <div class="portal-chip-row">
            <button class="portal-chip @(CategoryId is null ? "active" : null)" @onclick="() => SelectCategory(null)"><Icon Name="grid" Size="14" /> All</button>
            @foreach (var category in _categories)
            {
                <button class="portal-chip @(CategoryId == category.Id ? "active" : null)" @key="category.Id" @onclick="() => SelectCategory(category.Id)">
                    <Icon Name="@category.Icon" Size="14" /> @category.Name <span class="chip-count">@category.ItemCount</span>
                </button>
            }
        </div>
    </div>

    @if (_selectedCategory?.Description is { Length: > 0 } description)
    {
        <p class="muted small mt-4 mb-0">@description</p>
    }

    <div class="portal-section" style="margin-top:20px">
        @if (_loading)
        {
            <div class="portal-card-grid">
                @for (var i = 0; i < 8; i++)
                {
                    <div class="card card-body"><Skeleton Lines="4" /></div>
                }
            </div>
        }
        else if (_items.Count == 0)
        {
            <div class="card">
                <EmptyState Icon="package" Title="Nothing found" Text="@(string.IsNullOrWhiteSpace(_search) ? "There are no orderable items in this category yet." : $"No catalog item matches “{_search}”. Describe what you need instead and we will help.")">
                    <a class="btn btn-primary" href="/portal/report"><Icon Name="message-square" Size="16" /> Tell us what you need</a>
                </EmptyState>
            </div>
        }
        else
        {
            <div class="small faint mb-3">@_items.Count item@(_items.Count == 1 ? string.Empty : "s")</div>
            <div class="portal-card-grid">
                @foreach (var item in _items)
                {
                    <PortalCatalogCard @key="item.Id" Item="item" />
                }
            </div>
        }
    </div>
</div>

@code {
    private IReadOnlyList<CatalogCategoryModel> _categories = [];
    private IReadOnlyList<CatalogItemCard> _items = [];
    private CatalogCategoryModel? _selectedCategory;
    private string? _search;
    private bool _loading = true;
    private CancellationTokenSource? _debounce;
    private Guid? _loadedCategory;
    private bool _initialized;

    /// <summary>Gets or sets the selected category (query string <c>?category=</c>).</summary>
    [SupplyParameterFromQuery(Name = "category")] public Guid? CategoryId { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var categories = await Catalog.GetCategoriesAsync();
        _categories = categories.Value ?? [];
        if (!categories.Succeeded)
        {
            Toasts.Error("The catalog could not be loaded", categories.Error);
        }
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (_initialized && _loadedCategory == CategoryId)
        {
            return;
        }

        _initialized = true;
        _selectedCategory = _categories.FirstOrDefault(c => c.Id == CategoryId);
        await LoadAsync();
    }

    /// <inheritdoc />
    public void Dispose()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadedCategory = CategoryId;
        var result = await Catalog.GetItemsAsync(CategoryId, _search, 200);
        _items = result.Value ?? [];
        _loading = false;
        if (!result.Succeeded)
        {
            Toasts.Error("The catalog could not be loaded", result.Error);
        }
    }

    private void SelectCategory(Guid? categoryId) =>
        Navigation.NavigateTo(categoryId is { } id ? $"/portal/catalog?category={id}" : "/portal/catalog");

    private async Task OnSearchInputAsync(ChangeEventArgs e)
    {
        _search = e.Value?.ToString();
        _debounce?.Cancel();
        _debounce?.Dispose();
        _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, _debounce.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await LoadAsync();
    }
}
