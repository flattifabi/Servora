@* Shows a newly created or rotated API key token exactly once, with copy button and ready-to-use snippets. *@
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ToastService Toasts

<Modal Open="Open" OpenChanged="OpenChanged" Size="lg" Icon="key" CloseOnBackdrop="false"
       Title="@($"Your API key for “{Secret?.Name}”")" Subtitle="Copy it now – it cannot be displayed again.">
    <ChildContent>
        @if (Secret is not null)
        {
            <div class="alert alert-warning mb-4">
                <Icon Name="alert-triangle" Size="18" />
                <div>Servora stores only a SHA-256 hash of this key. If you lose it, rotate the key to get a new secret. Treat it like a password.</div>
            </div>
            <div class="secret-reveal">
                <span class="flex-1">@(_visible ? Secret.Token : Masked)</span>
                <button class="icon-btn" title="@(_visible ? "Hide" : "Show")" @onclick="() => _visible = !_visible"><Icon Name="@(_visible ? "eye-off" : "eye")" Size="16" /></button>
                <button class="btn btn-primary btn-sm" @onclick="CopyAsync"><Icon Name="@(_copied ? "check" : "copy")" Size="14" /> @(_copied ? "Copied" : "Copy")</button>
            </div>

            <div class="eyebrow mt-6 mb-2">Try it</div>
            <pre>curl -H "X-Api-Key: $SERVORA_API_KEY" @(BaseUrl)api/v1/me</pre>
            <div class="eyebrow mt-4 mb-2">MCP client (generic JSON)</div>
            <pre>@McpSnippet</pre>

            <label class="checkbox mt-4"><input type="checkbox" @bind="_acknowledged" /> I have stored the key in a safe place.</label>
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-primary" disabled="@(!_acknowledged && !_copied)" @onclick="CloseAsync"><Icon Name="check" Size="16" /> Done</button>
    </Footer>
</Modal>

@code {
    private bool _visible;
    private bool _copied;
    private bool _acknowledged;
    private ApiKeySecretResult? _shown;

    /// <summary>Gets or sets a value indicating whether the dialog is open.</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Raised when the open state changes.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Gets or sets the secret to show.</summary>
    [Parameter] public ApiKeySecretResult? Secret { get; set; }

    private string BaseUrl => Navigation.BaseUri;

    private string Masked => Secret is null ? string.Empty : Secret.Token[..Math.Min(17, Secret.Token.Length)] + new string('•', 24);

    private string McpSnippet => $$"""
        {
          "mcpServers": {
            "servora": {
              "type": "http",
              "url": "{{BaseUrl}}mcp",
              "headers": { "Authorization": "Bearer <your key>" }
            }
          }
        }
        """;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_shown, Secret))
        {
            _shown = Secret;
            _visible = false;
            _copied = false;
            _acknowledged = false;
        }
    }

    private async Task CopyAsync()
    {
        if (Secret is null)
        {
            return;
        }

        _copied = await JS.InvokeAsync<bool>("servora.copy", Secret.Token);
        if (_copied)
        {
            Toasts.Success("API key copied to the clipboard");
        }
        else
        {
            _visible = true;
            Toasts.Warning("Copy failed", "Select the key and copy it manually.");
        }
    }

    private Task CloseAsync() => OpenChanged.InvokeAsync(false);
}
