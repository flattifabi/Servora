<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Host: Blazor Web App (Interactive Server), REST API endpoints, MCP endpoint and Windows Service hosting.
  -->
  <PropertyGroup>
    <RootNamespace>Servora.Web</RootNamespace>
    <AssemblyName>Servora</AssemblyName>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <UserSecretsId>servora-web-dev</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Servora.Infrastructure\Servora.Infrastructure.csproj" />
    <ProjectReference Include="..\Servora.Persistence.Sqlite\Servora.Persistence.Sqlite.csproj" />
    <ProjectReference Include="..\Servora.Persistence.SqlServer\Servora.Persistence.SqlServer.csproj" />
    <ProjectReference Include="..\Servora.Persistence.PostgreSql\Servora.Persistence.PostgreSql.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Servora.Tests.Integration" />
  </ItemGroup>
</Project>
