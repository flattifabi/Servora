@* Renders the input of one catalog variable (order forms, builder preview, portal). Values are strings in the format
   expected by CatalogVariableValidator (dates yyyy-MM-dd, booleans true/false, users as GUID). *@

<FormField Label="@Definition.Label" Required="Definition.Mandatory" Help="@Definition.HelpText" Error="@Error" Class="@Class">
    @switch (Definition.Type)
    {
        case CatalogVariableType.MultilineText:
            <textarea class="textarea" rows="4" value="@Value" disabled="@Disabled" maxlength="@(Definition.MaxLength ?? CatalogVariableValidator.DefaultMultilineLength)"
                      @onchange="e => SetAsync(e.Value?.ToString())"></textarea>
            break;
        case CatalogVariableType.Number:
            <input class="input" type="number" step="any" value="@Value" disabled="@Disabled" min="@Definition.MinValue" max="@Definition.MaxValue"
                   @onchange="e => SetAsync(e.Value?.ToString())" />
            break;
        case CatalogVariableType.Choice:
            @if (Definition.Options.Count <= 4)
            {
                <div class="choice-chips">
                    @foreach (var option in Definition.Options)
                    {
                        <button type="button" class="choice-chip @(string.Equals(option, Value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)" disabled="@Disabled"
                                @onclick="() => SetAsync(option)">@option</button>
                    }
                </div>
            }
            else
            {
                <select class="select" value="@Value" disabled="@Disabled" @onchange="e => SetAsync(e.Value?.ToString())">
                    <option value="">— Select —</option>
                    @foreach (var option in Definition.Options)
                    {
                        <option value="@option">@option</option>
                    }
                </select>
            }
            break;
        case CatalogVariableType.Boolean:
            <Switch Value="@(Value == "true")" ValueChanged="@(v => SetAsync(v ? "true" : "false"))" Disabled="Disabled" Label="@(Value == "true" ? "Yes" : "No")" />
            break;
        case CatalogVariableType.Date:
            <input class="input" type="date" value="@Value" disabled="@Disabled" @onchange="e => SetAsync(e.Value?.ToString())" />
            break;
        case CatalogVariableType.UserReference:
            <UserPicker Value="@UserValue" ValueChanged="v => SetAsync(v?.ToString())" Disabled="Disabled" />
            break;
        default:
            <input class="input" value="@Value" disabled="@Disabled" maxlength="@(Definition.MaxLength ?? CatalogVariableValidator.DefaultTextLength)"
                   @onchange="e => SetAsync(e.Value?.ToString())" />
            break;
    }
</FormField>

@code {
    /// <summary>Gets or sets the variable definition.</summary>
    [Parameter, EditorRequired] public CatalogVariableDefinition Definition { get; set; } = default!;

    /// <summary>Gets or sets the current value.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Raised when the value changes.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Gets or sets the validation error.</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>Gets or sets a value indicating whether the input is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Gets or sets extra CSS classes of the field (for example <c>span-all</c>).</summary>
    [Parameter] public string? Class { get; set; }

    private Guid? UserValue => Guid.TryParse(Value, out var id) ? id : null;

    private async Task SetAsync(string? value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
