@* Layout for sign-in, password change and setup pages: aurora hero on the left, form panel on the right. *@
@inherits LayoutComponentBase
@using Servora.Application.Configuration
@inject IBrandingService BrandingService
@inject BrandingState Branding
@inject IJSRuntime JS

<div class="auth-shell">
    <section class="auth-hero">
        <div class="flex items-center gap-3">
            @if (_branding.LogoUrl is { } logo)
            {
                <img class="brand-logo" src="@logo" alt="" />
            }
            else
            {
                <div class="brand-mark"><Icon Name="sparkles" Size="18" /></div>
            }
            <div>
                <div class="brand-name" style="color:#fff">@_branding.ProductName</div>
                <div class="brand-sub" style="color:rgba(255,255,255,.55)">@(string.IsNullOrWhiteSpace(_branding.CompanyName) ? "Service Platform" : _branding.CompanyName)</div>
            </div>
        </div>
        <div>
            <h1>Run every service your business depends on — on your own terms.</h1>
            <p>Incidents, changes, requests, knowledge, CMDB, automation and AI agents in one open-source, self-hosted platform.</p>
        </div>
        <div class="auth-features">
            <div class="auth-feature"><div class="icon-wrap"><Icon Name="shield-check" Size="17" /></div><div><b>Self-hosted & secure</b><span>Your data, your network, your keys.</span></div></div>
            <div class="auth-feature"><div class="icon-wrap"><Icon Name="workflow" Size="17" /></div><div><b>No-code automation</b><span>Flows, rules, SLAs and approvals.</span></div></div>
            <div class="auth-feature"><div class="icon-wrap"><Icon Name="id-card" Size="17" /></div><div><b>Active Directory</b><span>LDAP sign-in and Windows SSO.</span></div></div>
            <div class="auth-feature"><div class="icon-wrap"><Icon Name="bot" Size="17" /></div><div><b>AI & MCP ready</b><span>Scoped agents and tools.</span></div></div>
        </div>
    </section>
    <section class="auth-panel">
        @Body
    </section>
</div>

@code {
    private BrandingInfo _branding = BrandingInfo.Default;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        // Works for static (sign-in) and interactive (setup) rendering; defaults are returned while no database exists.
        _branding = Branding.Current;
        _branding = await Branding.RefreshAsync(BrandingService);
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only interactive pages (setup wizard) show the splash screen; static pages never run this method.
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("servora.hideSplash");
            }
            catch (JSDisconnectedException)
            {
                // The circuit closed before the first render completed.
            }
        }
    }
}
