@page "/account/change-password"
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@using System.Security.Claims
@using Servora.Infrastructure.Security

<PageTitle>Change password · Servora</PageTitle>

<div class="auth-card">
    <div class="eyebrow mb-2">Account security</div>
    <h2>@(MustChange ? "Set a new password" : "Change your password")</h2>
    <p class="lead">
        @if (MustChange)
        {
            <span>Your password must be changed before you can continue. Choose a strong password you do not use anywhere else.</span>
        }
        else
        {
            <span>Choose a strong password you do not use anywhere else.</span>
        }
    </p>

    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger mb-4"><Icon Name="alert-circle" Size="18" /><div>@Error</div></div>
    }

    <form method="post" action="/auth/change-password" class="stack" style="gap:16px">
        <AntiforgeryToken />
        <div class="field">
            <label for="currentPassword">Current password</label>
            <input id="currentPassword" name="currentPassword" type="password" class="input" autocomplete="current-password" required />
        </div>
        <div class="field">
            <label for="newPassword">New password</label>
            <input id="newPassword" name="newPassword" type="password" class="input" autocomplete="new-password" required minlength="10" />
            <div class="help">At least 10 characters with upper and lower case letters and a digit.</div>
        </div>
        <div class="field">
            <label for="confirmPassword">Confirm new password</label>
            <input id="confirmPassword" name="confirmPassword" type="password" class="input" autocomplete="new-password" required minlength="10" />
        </div>
        <button type="submit" class="btn btn-primary btn-lg btn-block"><Icon Name="shield-check" Size="18" /> Update password</button>
    </form>

    @if (!MustChange)
    {
        <a class="btn btn-ghost btn-block mt-3" href="/">Cancel</a>
    }
</div>

@code {
    /// <summary>Gets or sets the HTTP context.</summary>
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    /// <summary>Gets or sets the error message.</summary>
    [SupplyParameterFromQuery] public string? Error { get; set; }

    private bool MustChange => HttpContext.User.HasClaim(ServoraClaimTypes.MustChangePassword, "true");
}
