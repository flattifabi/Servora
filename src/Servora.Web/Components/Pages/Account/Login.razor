@page "/login"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@using Servora.Application.Identity.Windows
@inject IWindowsSignInService WindowsSignIn
@inject ILogger<Login> Logger
@inject ISystemSettingsService Settings
@using Servora.Application.Configuration

<PageTitle>Sign in · @Brand.ProductName</PageTitle>

<div class="auth-card">
    <div class="eyebrow mb-2">Welcome back</div>
    <h2>Sign in to @Brand.ProductName</h2>
    <p class="lead">Use your company account or a local @Brand.ProductName account.</p>

    @if (!string.IsNullOrWhiteSpace(_banner))
    {
        @* Plain text only (rendered encoded, line breaks preserved). *@
        <div class="alert alert-info mb-4" role="note"><Icon Name="info" Size="18" /><div style="white-space:pre-wrap">@_banner</div></div>
    }

    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger mb-4"><Icon Name="alert-circle" Size="18" /><div>@Error</div></div>
    }
    @if (SignedOut == 1)
    {
        <div class="alert alert-success mb-4"><Icon Name="check-circle" Size="18" /><div>You have been signed out.</div></div>
    }
    @if (SessionsRevoked == 1)
    {
        <div class="alert alert-info mb-4"><Icon Name="shield-check" Size="18" /><div>All of your sessions were signed out. Sign in again to continue.</div></div>
    }

    <form method="post" action="/auth/login" class="stack" style="gap:16px">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <div class="field">
            <label for="userName">User name</label>
            <div class="input-icon">
                <Icon Name="user" Size="16" />
                <input id="userName" name="userName" class="input" autocomplete="username" required autofocus value="@UserName" placeholder="jane.doe or DOMAIN\jane.doe" />
            </div>
        </div>
        <div class="field">
            <label for="password">Password</label>
            <div class="input-icon">
                <Icon Name="lock" Size="16" />
                <input id="password" name="password" type="password" class="input" autocomplete="current-password" required placeholder="••••••••" />
            </div>
        </div>
        <div class="flex items-center justify-between">
            <label class="checkbox"><input type="checkbox" name="rememberMe" value="true" /> Keep me signed in</label>
        </div>
        <button type="submit" class="btn btn-primary btn-lg btn-block"><Icon Name="log-in" Size="18" /> Sign in</button>
    </form>

    @if (_windowsEnabled)
    {
        <div class="auth-divider">or</div>
        <a class="btn btn-secondary btn-lg btn-block" href="/auth/windows?returnUrl=@Uri.EscapeDataString(ReturnUrl ?? "/")" data-enhance-nav="false">
            <Icon Name="monitor" Size="18" /> Sign in with Windows
        </a>
    }

    <p class="small faint mt-6 text-center">
        Protected system. Access is logged and monitored.
    </p>
</div>

@code {
    private bool _windowsEnabled;
    private string? _banner;

    /// <summary>Gets or sets the error message passed back by the login endpoint.</summary>
    [SupplyParameterFromQuery] public string? Error { get; set; }

    /// <summary>Gets or sets the previously entered user name.</summary>
    [SupplyParameterFromQuery] public string? UserName { get; set; }

    /// <summary>Gets or sets the local URL to return to after sign-in.</summary>
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    /// <summary>Gets or sets a flag indicating the user just signed out.</summary>
    [SupplyParameterFromQuery] public int? SignedOut { get; set; }

    /// <summary>Gets or sets a flag indicating the user revoked all sessions.</summary>
    [SupplyParameterFromQuery] public int? SessionsRevoked { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // The Windows button is only offered when Windows sign-in is enabled on /admin/directory.
            _windowsEnabled = await WindowsSignIn.IsEnabledAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not determine whether Windows sign-in is enabled.");
        }

        try
        {
            // Optional legal / usage notice configured under System settings › General.
            var banner = await Settings.GetStringAsync(SystemSettingKeys.LoginBanner);
            _banner = string.IsNullOrWhiteSpace(banner) ? null : banner.Trim();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load the sign-in notice.");
        }
    }
}
