@page "/account/change-password"
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@using System.Security.Claims
@using Servora.Application.Identity
@using Servora.Application.Identity.Policies
@using Servora.Infrastructure.Security
@inject IAuthPolicyProvider PolicyProvider

<PageTitle>Change password · @Brand.ProductName</PageTitle>

<div class="auth-card">
    <div class="eyebrow mb-2">Account security</div>
    <h2>@(MustChange ? "Set a new password" : "Change your password")</h2>
    <p class="lead">
        @if (MustChange)
        {
            <span>Your password must be changed before you can continue. Choose a strong password you do not use anywhere else.</span>
        }
        else
        {
            <span>Choose a strong password you do not use anywhere else.</span>
        }
    </p>

    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger mb-4"><Icon Name="alert-circle" Size="18" /><div>@Error</div></div>
    }

    @if (!IsLocalAccount)
    {
        <div class="alert alert-info mb-4">
            <Icon Name="info" Size="18" />
            <div>Your account is managed by your organisation's directory. Change your password with your usual Windows / directory tools.</div>
        </div>
        <a class="btn btn-secondary btn-block" href="/profile">Back to my profile</a>
    }
    else
    {
        <form method="post" action="/auth/change-password" class="stack" style="gap:16px">
            <AntiforgeryToken />
            <div class="field">
                <label for="currentPassword">Current password</label>
                <input id="currentPassword" name="currentPassword" type="password" class="input" autocomplete="current-password" required />
            </div>
            <div class="field">
                <label for="newPassword">New password</label>
                <input id="newPassword" name="newPassword" type="password" class="input" autocomplete="new-password" required minlength="@_policy.MinimumLength" />
                <div class="help">@_policy.Describe()</div>
            </div>
            <div class="field">
                <label for="confirmPassword">Confirm new password</label>
                <input id="confirmPassword" name="confirmPassword" type="password" class="input" autocomplete="new-password" required minlength="@_policy.MinimumLength" />
            </div>
            <button type="submit" class="btn btn-primary btn-lg btn-block"><Icon Name="shield-check" Size="18" /> Update password</button>
        </form>

        @if (!MustChange)
        {
            <a class="btn btn-ghost btn-block mt-3" href="/">Cancel</a>
        }
    }
</div>

@code {
    private PasswordPolicy _policy = PasswordPolicy.Default;

    /// <summary>Gets or sets the HTTP context.</summary>
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    /// <summary>Gets or sets the error message.</summary>
    [SupplyParameterFromQuery] public string? Error { get; set; }

    private bool MustChange => HttpContext.User.HasClaim(ServoraClaimTypes.MustChangePassword, "true");

    private bool IsLocalAccount => (HttpContext.User.FindFirstValue(ServoraClaimTypes.AuthSource) ?? "local") == "local";

    /// <inheritdoc />
    protected override async Task OnInitializedAsync() => _policy = await PolicyProvider.GetPasswordPolicyAsync();
}
