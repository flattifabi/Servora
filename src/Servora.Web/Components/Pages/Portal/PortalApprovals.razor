@page "/portal/approvals"
@* Approvals for approvers: the user's pending approvals and decision history (IApprovalInboxService – only the user's own
   approvals), expandable details of what is approved (IPortalApprovalService) and approve / reject with comment. *@
@attribute [RequirePermission(Permissions.Portal.Access)]
@inject IApprovalInboxService Inbox
@inject IPortalApprovalService ApprovalDetails
@inject ToastService Toasts

<PageTitle>Approvals · @Brand.ProductName</PageTitle>

<div class="portal-container">
    <div class="portal-page-head">
        <div class="portal-crumbs"><a href="/portal">Portal</a> <Icon Name="chevron-right" Size="12" /> <span>Approvals</span></div>
        <h1>Approvals</h1>
        <p>@(_stats is { Pending: > 0 } ? $"{_stats.Pending} request{(_stats.Pending == 1 ? " is" : "s are")} waiting for your decision." : "Requests that need your decision appear here.")</p>
    </div>

    <div class="flex items-center justify-between gap-3 flex-wrap">
        <div class="segmented" role="tablist">
            <button role="tab" aria-selected="@(_filter == ApprovalInboxFilter.MyPending)" class="@(_filter == ApprovalInboxFilter.MyPending ? "active" : null)" @onclick="() => SetFilterAsync(ApprovalInboxFilter.MyPending)">
                Waiting for me @if (_stats is { Pending: > 0 })
                {
                    <span class="portal-chip-count">@_stats.Pending</span>
                }
            </button>
            <button role="tab" aria-selected="@(_filter == ApprovalInboxFilter.MyHistory)" class="@(_filter == ApprovalInboxFilter.MyHistory ? "active" : null)" @onclick="() => SetFilterAsync(ApprovalInboxFilter.MyHistory)">History</button>
        </div>
        @if (_stats is not null)
        {
            <div class="flex gap-3 small muted">
                <span><Icon Name="check-circle" Size="14" Class="text-success" /> @_stats.ApprovedLast30Days approved</span>
                <span><Icon Name="x-circle" Size="14" Class="text-danger" /> @_stats.RejectedLast30Days rejected</span>
                <span class="faint">last 30 days</span>
            </div>
        }
    </div>

    <div class="portal-section" style="margin-top:18px">
        @if (_items is null)
        {
            <div class="stack" style="gap:12px">
                @for (var i = 0; i < 3; i++)
                {
                    <div class="card card-body"><Skeleton Lines="3" /></div>
                }
            </div>
        }
        else if (_items.Count == 0)
        {
            <div class="card">
                <EmptyState Icon="check-square" Title="@(_filter == ApprovalInboxFilter.MyPending ? "Nothing waiting for you" : "No decisions yet")"
                            Text="@(_filter == ApprovalInboxFilter.MyPending ? "You're all caught up. New approval requests will show up here." : "Approvals you decided will show up here.")" />
            </div>
        }
        else
        {
            <div class="stack" style="gap:12px">
                @foreach (var item in _items)
                {
                    var expanded = _expanded.Contains(item.Id);
                    <div class="card pappr @(item.CanDecide ? "pending" : null)" @key="item.Id">
                        <div class="pappr-main">
                            <span class="portal-icon-tile"><Icon Name="@(item.TableName == "change_request" ? "git-pull-request" : "shopping-cart")" Size="20" /></span>
                            <div class="flex-1" style="min-width:0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="tag mono">@item.RecordNumber</span>
                                    <span class="tiny faint">@item.TableLabel</span>
                                    <StatusPill Text="@ApprovalLabel(item.State)" Tone="@ApprovalTone(item.State)" />
                                </div>
                                <div class="pappr-title">@(item.RecordSummary ?? item.Reason ?? "Approval")</div>
                                <div class="pappr-meta">
                                    @if (item.RequestedByName is not null)
                                    {
                                        <span>Requested by @item.RequestedByName</span>
                                        <span>·</span>
                                    }
                                    <span><RelativeTime Value="item.RequestedAt" /></span>
                                    @if (item.GroupName is not null)
                                    {
                                        <span>·</span>
                                        <span>via @item.GroupName</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.Reason) && item.Reason != item.RecordSummary)
                                {
                                    <div class="pappr-reason">@item.Reason</div>
                                }
                                @if (!item.CanDecide && !string.IsNullOrWhiteSpace(item.Comments))
                                {
                                    <div class="pappr-comment"><Icon Name="message-square" Size="13" /> @item.Comments</div>
                                }
                            </div>
                            <div class="pappr-actions">
                                @if (item.CanDecide)
                                {
                                    <button class="btn btn-success btn-sm" disabled="@_busy" @onclick="() => OpenDecision(item, true)"><Icon Name="check" Size="14" /> Approve</button>
                                    <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => OpenDecision(item, false)"><Icon Name="x" Size="14" /> Reject</button>
                                }
                                else if (item.DecidedAt is not null)
                                {
                                    <span class="small faint">Decided <RelativeTime Value="item.DecidedAt" /></span>
                                }
                                <button class="btn btn-ghost btn-sm" @onclick="() => ToggleAsync(item.Id)" aria-expanded="@expanded">
                                    <Icon Name="@(expanded ? "chevron-up" : "chevron-down")" Size="14" /> Details
                                </button>
                            </div>
                        </div>
                        @if (expanded)
                        {
                            <div class="pappr-details">
                                @if (_subjects.GetValueOrDefault(item.Id) is not { } subject)
                                {
                                    <Skeleton Lines="3" />
                                }
                                else
                                {
                                    @if (!string.IsNullOrWhiteSpace(subject.Description))
                                    {
                                        <p class="small muted" style="margin-top:0;white-space:pre-line">@subject.Description</p>
                                    }
                                    <div class="pappr-grid">
                                        <dl class="portal-facts">
                                            @foreach (var fact in subject.Facts.Where(f => f.Value is not null))
                                            {
                                                <dt>@fact.Label</dt><dd>@fact.Value</dd>
                                            }
                                        </dl>
                                        @if (subject.Answers.Count > 0)
                                        {
                                            <dl class="portal-facts">
                                                @foreach (var answer in subject.Answers)
                                                {
                                                    <dt>@answer.Label</dt><dd>@(string.IsNullOrWhiteSpace(answer.Value) ? "—" : answer.Value)</dd>
                                                }
                                            </dl>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            @if (_total > _items.Count)
            {
                <div class="flex justify-center mt-6">
                    <button class="btn btn-secondary" @onclick="LoadMoreAsync">Show more</button>
                </div>
            }
        }
    </div>
</div>

<Modal @bind-Open="_decisionOpen" Title="@(_approve ? "Approve request" : "Reject request")" Subtitle="@_decisionItem?.RecordSummary" Icon="@(_approve ? "check-circle" : "x-circle")">
    <ChildContent>
        <FormField Label="@(_approve ? "Comment (optional)" : "Reason")" Required="!_approve" Error="@_decisionError"
                   Help="@(_approve ? "Your comment is stored with the decision." : "Explain why – the reason is stored with the decision.")">
            <textarea class="textarea" rows="4" maxlength="2000" @bind="_comment" @bind:event="oninput"></textarea>
        </FormField>
    </ChildContent>
    <Footer>
        <button class="btn btn-secondary" @onclick="() => _decisionOpen = false">Cancel</button>
        <button class="btn @(_approve ? "btn-success" : "btn-danger")" disabled="@_busy" @onclick="DecideAsync">
            @if (_busy)
            {
                <span class="spinner"></span>
            }
            @(_approve ? "Approve" : "Reject")
        </button>
    </Footer>
</Modal>

@code {
    private const int PageSize = 20;

    private List<ApprovalItem>? _items;
    private ApprovalInboxStats? _stats;
    private ApprovalInboxFilter _filter = ApprovalInboxFilter.MyPending;
    private readonly HashSet<Guid> _expanded = [];
    private readonly Dictionary<Guid, PortalApprovalSubject> _subjects = [];
    private int _page = 1;
    private int _total;
    private bool _busy;
    private bool _decisionOpen;
    private bool _approve;
    private ApprovalItem? _decisionItem;
    private string _comment = string.Empty;
    private string? _decisionError;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _page = 1;
        var stats = await Inbox.GetStatsAsync();
        _stats = stats.Value;
        var result = await Inbox.ListAsync(_filter, new PageRequest { Page = 1, PageSize = PageSize });
        if (!result.Succeeded || result.Value is null)
        {
            _items = [];
            _total = 0;
            Toasts.Error("Your approvals could not be loaded", result.Error);
            return;
        }

        _items = result.Value.Items.ToList();
        _total = result.Value.TotalCount;
    }

    private async Task LoadMoreAsync()
    {
        var result = await Inbox.ListAsync(_filter, new PageRequest { Page = _page + 1, PageSize = PageSize });
        if (result.Succeeded && result.Value is not null && _items is not null)
        {
            _page++;
            _items.AddRange(result.Value.Items.Where(n => _items.All(i => i.Id != n.Id)));
            _total = result.Value.TotalCount;
        }
    }

    private async Task SetFilterAsync(ApprovalInboxFilter filter)
    {
        _filter = filter;
        _items = null;
        _expanded.Clear();
        await ReloadAsync();
    }

    private async Task ToggleAsync(Guid approvalId)
    {
        if (!_expanded.Add(approvalId))
        {
            _expanded.Remove(approvalId);
            return;
        }

        if (!_subjects.ContainsKey(approvalId))
        {
            var result = await ApprovalDetails.GetSubjectAsync(approvalId);
            if (result.Succeeded && result.Value is not null)
            {
                _subjects[approvalId] = result.Value;
            }
            else
            {
                _expanded.Remove(approvalId);
                Toasts.Error("The details could not be loaded", result.Error);
            }
        }
    }

    private void OpenDecision(ApprovalItem item, bool approve)
    {
        _decisionItem = item;
        _approve = approve;
        _comment = string.Empty;
        _decisionError = null;
        _decisionOpen = true;
    }

    private async Task DecideAsync()
    {
        if (_decisionItem is null)
        {
            return;
        }

        if (!_approve && string.IsNullOrWhiteSpace(_comment))
        {
            _decisionError = "Please give a reason for the rejection.";
            return;
        }

        _busy = true;
        try
        {
            var result = _approve
                ? await Inbox.ApproveAsync(_decisionItem.Id, string.IsNullOrWhiteSpace(_comment) ? null : _comment)
                : await Inbox.RejectAsync(_decisionItem.Id, _comment);
            if (Toasts.FromResult(result, _approve ? $"{_decisionItem.RecordNumber} approved" : $"{_decisionItem.RecordNumber} rejected"))
            {
                _decisionOpen = false;
                _subjects.Remove(_decisionItem.Id);
                await ReloadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private static string ApprovalLabel(Servora.Domain.Approvals.ApprovalRecordState state) => state switch
    {
        Servora.Domain.Approvals.ApprovalRecordState.Requested => "Waiting for you",
        Servora.Domain.Approvals.ApprovalRecordState.Approved => "Approved",
        Servora.Domain.Approvals.ApprovalRecordState.Rejected => "Rejected",
        Servora.Domain.Approvals.ApprovalRecordState.Cancelled => "Withdrawn",
        Servora.Domain.Approvals.ApprovalRecordState.NotRequired => "No longer needed",
        _ => state.ToString(),
    };

    private static string ApprovalTone(Servora.Domain.Approvals.ApprovalRecordState state) => state switch
    {
        Servora.Domain.Approvals.ApprovalRecordState.Requested => "warning",
        Servora.Domain.Approvals.ApprovalRecordState.Approved => "success",
        Servora.Domain.Approvals.ApprovalRecordState.Rejected => "danger",
        _ => "neutral",
    };
}
