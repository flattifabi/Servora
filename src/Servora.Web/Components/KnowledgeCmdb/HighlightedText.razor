@* Plain text with highlighted search terms (rendered as encoded text, never as raw HTML). *@
@foreach (var segment in SearchHighlighter.Split(Text, Terms))
{
    if (segment.IsMatch)
    {
        <mark class="hl">@segment.Text</mark>
    }
    else
    {
        @segment.Text
    }
}

@code {
    /// <summary>Gets or sets the text.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Gets or sets the terms to highlight.</summary>
    [Parameter] public IReadOnlyList<string> Terms { get; set; } = [];
}
