@page "/table/{Name}"
@* Generic list view of any table (typed or custom) with condition filter, search, sort and paging; table ACLs are enforced by the record service. *@
@attribute [RequirePermission(Permissions.Platform.ReadRecords)]
@inject ITableRegistry Registry
@inject IRecordService Records
@inject ITableDesignerService Designer
@inject ITableAccessService Access
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>@(_table?.PluralLabel ?? Name) · Servora</PageTitle>

@if (_table is null)
{
    @if (_loading)
    {
        <Skeleton Lines="8" Height="22px" />
    }
    else
    {
        <EmptyState Icon="table" Title="Table not found" Text="@($"There is no table named '{Name}'.")">
            <a class="btn btn-secondary" href="/admin/tables">Browse tables</a>
        </EmptyState>
    }
}
else if (_forbidden)
{
    <EmptyState Icon="lock" Title="No access" Text="@($"You do not have permission to read {_table.PluralLabel.ToLowerInvariant()}.")" />
}
else
{
    <PageHeader Title="@_table.PluralLabel" Icon="@_table.Icon">
        <Breadcrumbs><a href="/admin/tables">Tables</a> <Icon Name="chevron-right" Size="12" /> @_table.PluralLabel</Breadcrumbs>
        <SubtitleContent>
            <div class="flex items-center gap-2 mt-1">
                <span class="tag mono">@_table.Name</span>
                @if (_table.IsCustom)
                {
                    <span class="pill pill-accent no-dot">Custom table</span>
                }
                @if (!_table.IsCustom && !string.IsNullOrWhiteSpace(_table.Route) && _table.Route.StartsWith('/') && !_table.Route.StartsWith("/table/", StringComparison.Ordinal))
                {
                    <a class="small" href="@_table.Route">Open module view <Icon Name="arrow-right" Size="12" /></a>
                }
            </div>
        </SubtitleContent>
        <Actions>
            <PermissionView Permission="@Permissions.Platform.ManageTables">
                <a class="btn btn-secondary" href="@($"/admin/tables/{_table.Name}")"><Icon Name="settings" Size="16" /> Configure</a>
            </PermissionView>
            @if (_canCreate)
            {
                <a class="btn btn-primary" href="@($"/table/{_table.Name}/new")"><Icon Name="plus" Size="16" /> New @_table.Label.ToLowerInvariant()</a>
            }
        </Actions>
    </PageHeader>

    <div class="grid grid-4 mb-6">
        <StatCard Label="@(FilterCount > 0 ? "Matching records" : "Records")" Value="@(_page?.TotalCount.ToString("N0") ?? "–")" Icon="@_table.Icon" Caption="@(FilterCount > 0 ? "with the current filter" : "in this table")" />
        <StatCard Label="Created this week" Value="@(_createdWeek?.ToString("N0") ?? "–")" Icon="plus" Tone="success" Caption="last 7 days" />
        <StatCard Label="Updated today" Value="@(_updatedToday?.ToString("N0") ?? "–")" Icon="refresh" Tone="info" Caption="last 24 hours" />
        <StatCard Label="Fields" Value="@_table.Fields.Count.ToString()" Icon="edit" Tone="accent" Caption="@($"{_table.Fields.Count(f => f.IsCustom)} custom")" />
    </div>

    @if (_filterOpen)
    {
        <div class="card mb-4">
            <div class="card-header">
                <div>
                    <h3 class="flex items-center gap-2"><Icon Name="filter" Size="16" /> Filter</h3>
                    <div class="small muted">Conditions are evaluated in the database on every provider.</div>
                </div>
                <div class="flex gap-2">
                    <button class="btn btn-ghost btn-sm" @onclick="ClearFilterAsync">Clear</button>
                    <button class="btn btn-primary btn-sm" @onclick="ApplyFilterAsync"><Icon Name="check" Size="14" /> Apply</button>
                </div>
            </div>
            <div class="card-body">
                <ConditionBuilder Condition="_draft" Fields="_table.Fields" />
            </div>
        </div>
    }

    <DataTable TItem="RecordRow" Items="_rows" TotalCount="@(_page?.TotalCount ?? 0)" PageNumber="_pageNumber" PageSize="_pageSize"
               Loading="_busy" SortBy="@_sort" SortDescending="_desc" OnPageChanged="GoToPageAsync" OnSortChanged="SortAsync" OnSearch="SearchAsync"
               OnRowClick="@(r => Nav.NavigateTo($"/table/{_table.Name}/{r.Id}"))" SearchPlaceholder="@($"Search {_table.PluralLabel.ToLowerInvariant()}…")"
               EmptyIcon="@_table.Icon" EmptyTitle="@(FilterCount > 0 || !string.IsNullOrEmpty(_search) ? "No matching records" : $"No {_table.PluralLabel.ToLowerInvariant()} yet")"
               EmptyText="@(FilterCount > 0 || !string.IsNullOrEmpty(_search) ? "Change the filter or search term." : "Records created in the form or through the Table API appear here.")">
        <Toolbar>
            <button class="btn btn-secondary btn-sm @(_filterOpen ? "active" : null)" @onclick="ToggleFilter">
                <Icon Name="filter" Size="14" /> Filter
                @if (FilterCount > 0)
                {
                    <span class="badge">@FilterCount</span>
                }
            </button>
        </Toolbar>
        <ToolbarEnd>
            <select class="select" style="width:auto" value="@_pageSize" @onchange="ChangePageSizeAsync" title="Rows per page">
                @foreach (var size in s_pageSizes)
                {
                    <option value="@size">@size rows</option>
                }
            </select>
        </ToolbarEnd>
        <Columns>
            @foreach (var field in _columns)
            {
                var column = field;
                <DataColumn TItem="RecordRow" Title="@column.Label" SortKey="@column.Name"
                            Class="@(column.Name == _table.DisplayField ? "cell-primary" : null)">
                    <Template>
                        @if (column.Name == _table.DisplayField)
                        {
                            <span class="cell-link">@(FieldValueFormatter.Display(column, context.Values) is { Length: > 0 } text ? text : "(empty)")</span>
                        }
                        else
                        {
                            <FieldValueDisplay Field="column" Row="context.Values" />
                        }
                    </Template>
                </DataColumn>
            }
        </Columns>
    </DataTable>
}

@code {
    private static readonly int[] s_pageSizes = [10, 25, 50, 100];

    private TableDefinition? _table;
    private List<FieldDefinition> _columns = [];
    private PagedResult<IReadOnlyDictionary<string, object?>>? _page;
    private List<RecordRow> _rows = [];
    private ConditionGroup _filter = new();
    private ConditionGroup _draft = new();
    private int? _createdWeek;
    private int? _updatedToday;
    private bool _loading = true;
    private bool _busy;
    private bool _forbidden;
    private bool _canCreate;
    private bool _filterOpen;
    private string? _search;
    private string? _sort;
    private bool _desc;
    private int _pageNumber = 1;
    private int _pageSize = 25;
    private string? _loadedFor;

    /// <summary>Gets or sets the technical table name from the route.</summary>
    [Parameter] public string Name { get; set; } = string.Empty;

    /// <summary>Gets or sets an optional initial filter as condition JSON (<c>?query=</c>).</summary>
    [SupplyParameterFromQuery(Name = "query")] public string? Query { get; set; }

    private int FilterCount => CountRules(_filter);

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_loadedFor, Name, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _loadedFor = Name;
        _loading = true;
        _table = await Registry.GetTableAsync(Name);
        _page = null;
        _forbidden = false;
        if (_table is null)
        {
            _loading = false;
            return;
        }

        _filter = string.IsNullOrWhiteSpace(Query) ? new ConditionGroup() : SafeDeserialize(Query);
        _draft = Clone(_filter);
        _search = null;
        _pageNumber = 1;
        _sort = _table.FindField("UpdatedAt") is not null ? "UpdatedAt" : null;
        _desc = _sort is not null;
        _canCreate = _table.Fields.Any(f => !f.IsReadOnly) && await Access.IsAllowedAsync(_table.Name, TableOperation.Create);

        var layout = await Designer.GetLayoutAsync(_table.Name);
        var columnNames = layout.Succeeded && layout.Value!.ListColumns.Count > 0
            ? layout.Value.ListColumns
            : _table.Fields.Where(f => f.Type is not (FieldType.Text or FieldType.Json or FieldType.Guid)).Take(6).Select(f => f.Name).ToList();
        _columns = columnNames.Select(_table.FindField).OfType<FieldDefinition>().ToList();
        if (_columns.Count == 0)
        {
            _columns = [.. _table.Fields.Take(5)];
        }

        await LoadAsync();
        await LoadKpisAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        if (_table is null)
        {
            return;
        }

        _busy = true;
        var result = await Records.QueryAsync(_table.Name, new RecordQuery
        {
            Condition = _filter.IsEmpty ? null : _filter,
            Fields = _columns.Select(c => c.Name).Append("Id").Distinct(StringComparer.OrdinalIgnoreCase).ToList(),
            Page = new PageRequest { Page = _pageNumber, PageSize = _pageSize, Search = _search, SortBy = _sort, SortDescending = _desc },
        });
        _busy = false;
        if (result.Succeeded)
        {
            _page = result.Value;
            _rows = _page!.Items.Select(i => new RecordRow(i)).ToList();
        }
        else if (result.ErrorKind == ResultErrorKind.Forbidden)
        {
            _forbidden = true;
        }
        else
        {
            Toasts.Error("Records could not be loaded", result.Error);
        }
    }

    private async Task LoadKpisAsync()
    {
        if (_table is null || _forbidden)
        {
            return;
        }

        _createdWeek = await CountSinceAsync("CreatedAt", TimeSpan.FromDays(7));
        _updatedToday = await CountSinceAsync("UpdatedAt", TimeSpan.FromDays(1));
    }

    private async Task<int?> CountSinceAsync(string field, TimeSpan window)
    {
        if (_table?.FindField(field) is not { Type: FieldType.DateTime })
        {
            return null;
        }

        var since = DateTimeOffset.UtcNow.Subtract(window).ToString("O", System.Globalization.CultureInfo.InvariantCulture);
        var result = await Records.QueryAsync(_table.Name, new RecordQuery
        {
            Condition = new ConditionGroup { Rules = [new ConditionRule { Field = field, Operator = ConditionOperator.GreaterOrEqual, Value = since }] },
            Fields = ["Id"],
            IncludeDisplayValues = false,
            Page = new PageRequest { PageSize = 1 },
        });
        return result.Succeeded ? result.Value!.TotalCount : null;
    }

    private async Task GoToPageAsync(int page)
    {
        _pageNumber = page;
        await LoadAsync();
    }

    private async Task SortAsync((string SortBy, bool Descending) sort)
    {
        _sort = sort.SortBy;
        _desc = sort.Descending;
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task SearchAsync(string term)
    {
        _search = string.IsNullOrWhiteSpace(term) ? null : term.Trim();
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task ChangePageSizeAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
        {
            _pageSize = size;
            _pageNumber = 1;
            await LoadAsync();
        }
    }

    private void ToggleFilter()
    {
        _filterOpen = !_filterOpen;
        if (_filterOpen)
        {
            _draft = Clone(_filter);
        }
    }

    private async Task ApplyFilterAsync()
    {
        _filter = Clone(_draft);
        _pageNumber = 1;
        await LoadAsync();
        Nav.NavigateTo(_filter.IsEmpty ? $"/table/{_table!.Name}" : $"/table/{_table!.Name}?query={Uri.EscapeDataString(ConditionSerializer.Serialize(_filter) ?? string.Empty)}", replace: true);
    }

    private async Task ClearFilterAsync()
    {
        _draft = new ConditionGroup();
        await ApplyFilterAsync();
    }

    private static ConditionGroup Clone(ConditionGroup group) => ConditionSerializer.Deserialize(ConditionSerializer.Serialize(group));

    private static ConditionGroup SafeDeserialize(string? json) => ConditionSerializer.Deserialize(json);

    private static int CountRules(ConditionGroup group) =>
        group.Rules.Count(r => !string.IsNullOrWhiteSpace(r.Field)) + group.Groups.Sum(CountRules);
}
