@* Toggle switch bound to a boolean. *@
<label class="switch">
    <input type="checkbox" checked="@Value" disabled="@Disabled" @onchange="Changed" />
    <span class="track"></span>
    @if (!string.IsNullOrEmpty(Label))
    {
        <span>@Label</span>
    }
</label>

@code {
    /// <summary>Gets or sets the value.</summary>
    [Parameter] public bool Value { get; set; }

    /// <summary>Raised when the value changes.</summary>
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    /// <summary>Gets or sets the label.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Gets or sets a value indicating whether the switch is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    private async Task Changed(ChangeEventArgs e)
    {
        Value = e.Value is true;
        await ValueChanged.InvokeAsync(Value);
    }
}
