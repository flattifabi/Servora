@* Sidebar navigation filtered by the effective permissions of the current user. *@
@using Servora.Web.Navigation
@using Servora.Application.Configuration
@implements IDisposable
@inject ICurrentUser CurrentUser
@inject IPermissionService PermissionService
@inject UiStateService Ui
@inject IJSRuntime JS
@inject IBrandingService BrandingService
@inject BrandingState Branding

<aside class="sidebar">
    <a class="sidebar-brand" href="/" title="@_branding.ProductName">
        @if (_branding.LogoUrl is { } logo)
        {
            <img class="brand-logo" src="@logo" alt="" />
        }
        else
        {
            <div class="brand-mark"><Icon Name="sparkles" Size="18" /></div>
        }
        <div class="brand-text">
            <div class="brand-name">@_branding.ProductName</div>
            <div class="brand-sub">@(string.IsNullOrWhiteSpace(_branding.CompanyName) ? "Service Platform" : _branding.CompanyName)</div>
        </div>
    </a>

    <div class="sidebar-search" @onclick="() => Ui.SetPaletteOpen(true)" title="Search (Ctrl+K)">
        <Icon Name="search" Size="16" />
        <span>Search or jump to…</span>
        <kbd>Ctrl K</kbd>
    </div>

    <nav class="sidebar-nav">
        @foreach (var section in _sections)
        {
            var closed = _closedSections.Contains(section.Title);
            <div class="nav-section @(closed ? "closed" : null)">
                <div class="nav-section-title" @onclick="() => ToggleSection(section.Title)">
                    <span>@section.Title</span>
                    <Icon Name="chevron-down" Size="14" />
                </div>
                <div class="nav-items">
                    @foreach (var entry in section.Entries)
                    {
                        <NavLink class="nav-link" href="@entry.Route" Match="@(s_exactRoutes.Contains(entry.Route) ? NavLinkMatch.All : NavLinkMatch.Prefix)" title="@entry.Title">
                            <Icon Name="@entry.Icon" Size="18" />
                            <span>@entry.Title</span>
                        </NavLink>
                    }
                </div>
            </div>
        }
    </nav>

    <div class="sidebar-footer">
        <Avatar Name="@CurrentUser.DisplayName" />
        <div class="user-meta">
            <div class="name">@CurrentUser.DisplayName</div>
            <div class="role">@CurrentUser.Name</div>
        </div>
        <button class="icon-btn" title="@(Ui.SidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")" @onclick="ToggleCollapsed">
            <Icon Name="@(Ui.SidebarCollapsed ? "chevrons-right" : "chevrons-left")" Size="16" />
        </button>
    </div>
</aside>

@code {
    // Routes that are a prefix of another entry ("/", "/knowledge" vs "/knowledge/articles") only match exactly, so a
    // single entry is highlighted.
    private static readonly HashSet<string> s_exactRoutes = NavigationCatalog.AllEntries
        .Select(e => e.Route)
        .Where(route => route == "/" || NavigationCatalog.AllEntries.Any(other => other.Route.StartsWith(route + "/", StringComparison.OrdinalIgnoreCase)))
        .ToHashSet(StringComparer.OrdinalIgnoreCase);

    private readonly HashSet<string> _closedSections = [];
    private IReadOnlyList<NavSection> _sections = [];
    private BrandingInfo _branding = BrandingInfo.Default;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        Ui.Changed += OnUiChanged;
        _branding = Branding.Current;
        _branding = await Branding.RefreshAsync(BrandingService);
        var granted = CurrentUser.UserId is { } userId
            ? await PermissionService.GetUserPermissionsAsync(userId)
            : new HashSet<string>();

        _sections = NavigationCatalog.Sections
            .Select(s => s with { Entries = s.Entries.Where(e => e.Permission is null || PermissionMatcher.IsGranted(granted, e.Permission)).ToList() })
            .Where(s => s.Entries.Count > 0)
            .ToList();
    }

    /// <inheritdoc />
    public void Dispose() => Ui.Changed -= OnUiChanged;

    private void ToggleSection(string title)
    {
        if (!_closedSections.Remove(title))
        {
            _closedSections.Add(title);
        }
    }

    private async Task ToggleCollapsed()
    {
        Ui.SetSidebarCollapsed(!Ui.SidebarCollapsed);
        await JS.InvokeVoidAsync("servora.setSidebarCollapsed", Ui.SidebarCollapsed);
    }

    private void OnUiChanged() => InvokeAsync(StateHasChanged);
}
