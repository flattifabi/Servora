@page "/admin/secrets"
@* Secret store administration (T-03): write-only values, create, rotate, describe, delete; every change is audited. *@
@attribute [RequirePermission(Permissions.Configuration.ManageSecrets)]
@inject ISecretAdminService Secrets
@inject ToastService Toasts

<PageTitle>Secrets · Servora</PageTitle>

<PageHeader Title="Secrets" Subtitle="Encrypted credentials used by integrations. Values are write-only and never shown again after saving." Icon="key">
    <Breadcrumbs>
        <span>Administration</span> <Icon Name="chevron-right" Size="12" /> <span>Secrets</span>
    </Breadcrumbs>
    <Actions>
        <button class="btn btn-primary" @onclick="OpenCreate"><Icon Name="plus" Size="16" /> New secret</button>
    </Actions>
</PageHeader>

<div class="grid grid-4 mb-6">
    <StatCard Label="Stored secrets" Value="@(_stats?.Total.ToString() ?? "–")" Icon="key" Tone="primary" Caption="encrypted at rest" />
    <StatCard Label="Used by the platform" Value="@(_stats?.System.ToString() ?? "–")" Icon="shield-check" Tone="info" Caption="SMTP, LDAP, AI, data sources" />
    <StatCard Label="Rotated recently" Value="@(_stats?.RotatedLast90Days.ToString() ?? "–")" Icon="refresh" Tone="success" Caption="within 90 days" />
    <StatCard Label="Stale" Value="@(_stats?.Stale.ToString() ?? "–")" Icon="alert-triangle" Tone="@(_stats is { Stale: > 0 } ? "warning" : "accent")" Caption="@($"older than {SecretNameRules.StaleAfterDays} days")" />
</div>

<DataTable TItem="SecretSummary" Items="_page?.Items" TotalCount="@(_page?.TotalCount ?? 0)" PageNumber="_pageNumber" PageSize="PageSize"
           Loading="_loading" SortBy="@_sortBy" SortDescending="_sortDescending" SearchPlaceholder="Search name or description…"
           OnPageChanged="GoToPageAsync" OnSortChanged="SortAsync" OnSearch="SearchAsync"
           EmptyIcon="key" EmptyTitle="@(string.IsNullOrEmpty(_search) ? "No secrets yet" : "No matching secrets")"
           EmptyText="@(string.IsNullOrEmpty(_search) ? "Store credentials for integrations here instead of in configuration files." : "Try a different search term.")">
    <EmptyContent>
        @if (string.IsNullOrEmpty(_search))
        {
            <button class="btn btn-primary mt-4" @onclick="OpenCreate"><Icon Name="plus" Size="16" /> New secret</button>
        }
    </EmptyContent>
    <Columns>
        <DataColumn TItem="SecretSummary" Title="Name" SortKey="Name">
            <Template>
                <div class="flex items-center gap-2">
                    <span class="secret-icon"><Icon Name="lock" Size="13" /></span>
                    <span class="mono cell-primary">@context.Name</span>
                    @if (context.IsSystem)
                    {
                        <span class="pill pill-info no-dot">Platform</span>
                    }
                </div>
            </Template>
        </DataColumn>
        <DataColumn TItem="SecretSummary" Title="Description">
            <Template><span class="muted truncate secret-description">@(context.Description ?? "—")</span></Template>
        </DataColumn>
        <DataColumn TItem="SecretSummary" Title="Value" Width="120px">
            <Template><span class="masked" title="Write-only">••••••••</span></Template>
        </DataColumn>
        <DataColumn TItem="SecretSummary" Title="Value set" SortKey="ValueSetAt" Width="150px">
            <Template>
                <div class="flex items-center gap-2">
                    <RelativeTime Value="context.ValueSetAt" />
                    @if (context.ValueSetAt < DateTimeOffset.UtcNow.AddDays(-SecretNameRules.StaleAfterDays))
                    {
                        <span class="pill pill-warning no-dot">Stale</span>
                    }
                </div>
            </Template>
        </DataColumn>
        <DataColumn TItem="SecretSummary" Title="Last change" SortKey="UpdatedAt" Width="180px">
            <Template><span class="small muted">@context.UpdatedBy · <RelativeTime Value="context.UpdatedAt" /></span></Template>
        </DataColumn>
        <DataColumn TItem="SecretSummary" Title="" Width="130px" Align="right">
            <Template>
                <div class="flex gap-1 justify-end">
                    <button class="icon-btn" title="Rotate value" @onclick="() => OpenRotate(context)"><Icon Name="refresh" Size="16" /></button>
                    <button class="icon-btn" title="Edit description" @onclick="() => OpenEdit(context)"><Icon Name="edit" Size="16" /></button>
                    <button class="icon-btn danger" title="Delete" @onclick="() => AskDelete(context)"><Icon Name="trash" Size="16" /></button>
                </div>
            </Template>
        </DataColumn>
    </Columns>
</DataTable>

<Modal @bind-Open="_createOpen" Title="New secret" Subtitle="The value is encrypted immediately and cannot be displayed later." Icon="key" OnClose="ClearInputs">
    <ChildContent>
        <div class="stack" style="gap:14px">
            <FormField Label="Name" Required="true" Help="Lower-case, e.g. datasource.crm_token. Prefixes email., ldap., ai., datasource. are used by the platform.">
                <input class="input mono" maxlength="200" spellcheck="false" autocomplete="off" @bind="_name" @bind:event="oninput" />
            </FormField>
            <FormField Label="Description">
                <input class="input" maxlength="@SecretNameRules.MaxDescriptionLength" @bind="_description" />
            </FormField>
            <FormField Label="Value" Required="true" Help="Write-only. Paste the credential; it is never logged.">
                <input class="input mono" type="password" autocomplete="new-password" maxlength="@SecretNameRules.MaxValueLength" @bind="_value" @bind:event="oninput" />
            </FormField>
            @if (_dialogError is not null)
            {
                <div class="alert alert-danger"><Icon Name="alert-circle" Size="18" /><div>@_dialogError</div></div>
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="CloseDialogs">Cancel</button>
        <button class="btn btn-primary" @onclick="CreateAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_name) || string.IsNullOrEmpty(_value))">
            @if (_busy)
            {
                <span class="spinner"></span>
            }
            else
            {
                <Icon Name="lock" Size="16" />
            }
            Store secret
        </button>
    </Footer>
</Modal>

<Modal @bind-Open="_rotateOpen" Title="Rotate secret" Subtitle="@_target?.Name" Icon="refresh" OnClose="ClearInputs">
    <ChildContent>
        <div class="stack" style="gap:14px">
            <div class="alert alert-info"><Icon Name="info" Size="18" /><div>The new value replaces the current one immediately. Features using this secret pick it up on their next use.</div></div>
            <FormField Label="New value" Required="true">
                <input class="input mono" type="password" autocomplete="new-password" maxlength="@SecretNameRules.MaxValueLength" @bind="_value" @bind:event="oninput" />
            </FormField>
            <FormField Label="Confirm new value" Required="true" Error="@(!string.IsNullOrEmpty(_confirm) && _confirm != _value ? "The values do not match." : null)">
                <input class="input mono" type="password" autocomplete="new-password" maxlength="@SecretNameRules.MaxValueLength" @bind="_confirm" @bind:event="oninput" />
            </FormField>
            @if (_dialogError is not null)
            {
                <div class="alert alert-danger"><Icon Name="alert-circle" Size="18" /><div>@_dialogError</div></div>
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="CloseDialogs">Cancel</button>
        <button class="btn btn-primary" @onclick="RotateAsync" disabled="@(_busy || string.IsNullOrEmpty(_value) || _value != _confirm)">
            @if (_busy)
            {
                <span class="spinner"></span>
            }
            else
            {
                <Icon Name="refresh" Size="16" />
            }
            Rotate
        </button>
    </Footer>
</Modal>

<Modal @bind-Open="_editOpen" Title="Edit description" Subtitle="@_target?.Name" Icon="edit" Size="sm">
    <ChildContent>
        <FormField Label="Description">
            <textarea class="textarea" rows="3" maxlength="@SecretNameRules.MaxDescriptionLength" @bind="_description"></textarea>
        </FormField>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="CloseDialogs">Cancel</button>
        <button class="btn btn-primary" @onclick="SaveDescriptionAsync" disabled="@_busy"><Icon Name="save" Size="16" /> Save</button>
    </Footer>
</Modal>

<ConfirmDialog @bind-Open="_deleteOpen" Title="Delete secret?" ConfirmText="Delete permanently" Danger="true" OnConfirm="DeleteAsync">
    <p>The secret <b class="mono">@_target?.Name</b> is deleted permanently. This cannot be undone.</p>
    @if (_target?.IsSystem == true)
    {
        <div class="alert alert-warning mt-3"><Icon Name="alert-triangle" Size="18" /><div>This secret is used by a platform feature (for example SMTP or directory sign-in), which stops working until a new value is stored.</div></div>
    }
</ConfirmDialog>

@code {
    private const int PageSize = 25;
    private PagedResult<SecretSummary>? _page;
    private SecretStatistics? _stats;
    private bool _loading = true;
    private int _pageNumber = 1;
    private string? _search;
    private string? _sortBy = "Name";
    private bool _sortDescending;

    private bool _createOpen;
    private bool _rotateOpen;
    private bool _editOpen;
    private bool _deleteOpen;
    private bool _busy;
    private SecretSummary? _target;
    private string? _name;
    private string? _description;
    private string? _value;
    private string? _confirm;
    private string? _dialogError;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var page = await Secrets.ListAsync(new PageRequest { Page = _pageNumber, PageSize = PageSize, Search = _search, SortBy = _sortBy, SortDescending = _sortDescending });
            if (page.Succeeded)
            {
                _page = page.Value;
            }
            else
            {
                Toasts.Error("Secrets could not be loaded", page.Error);
            }

            var stats = await Secrets.GetStatisticsAsync();
            _stats = stats.Succeeded ? stats.Value : _stats;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task GoToPageAsync(int page)
    {
        _pageNumber = page;
        await ReloadAsync();
    }

    private async Task SortAsync((string SortBy, bool Descending) sort)
    {
        (_sortBy, _sortDescending) = sort;
        await ReloadAsync();
    }

    private async Task SearchAsync(string term)
    {
        _search = string.IsNullOrWhiteSpace(term) ? null : term;
        _pageNumber = 1;
        await ReloadAsync();
    }

    private void OpenCreate()
    {
        ClearInputs();
        _createOpen = true;
    }

    private void OpenRotate(SecretSummary secret)
    {
        ClearInputs();
        _target = secret;
        _rotateOpen = true;
    }

    private void OpenEdit(SecretSummary secret)
    {
        ClearInputs();
        _target = secret;
        _description = secret.Description;
        _editOpen = true;
    }

    private void AskDelete(SecretSummary secret)
    {
        _target = secret;
        _deleteOpen = true;
    }

    private void CloseDialogs()
    {
        _createOpen = _rotateOpen = _editOpen = false;
        ClearInputs();
    }

    /// <summary>Drops every typed value from component memory.</summary>
    private void ClearInputs()
    {
        _name = _description = _value = _confirm = _dialogError = null;
    }

    private async Task CreateAsync()
    {
        _busy = true;
        try
        {
            var result = await Secrets.CreateAsync(_name ?? string.Empty, _description, _value ?? string.Empty);
            if (result.Succeeded)
            {
                Toasts.Success("Secret stored", "The value is encrypted and write-only.");
                CloseDialogs();
                await ReloadAsync();
            }
            else
            {
                _dialogError = result.Error;
            }
        }
        finally
        {
            _value = null;
            _busy = false;
        }
    }

    private async Task RotateAsync()
    {
        if (_target is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Secrets.RotateAsync(_target.Name, _value ?? string.Empty);
            if (result.Succeeded)
            {
                Toasts.Success("Secret rotated", _target.Name);
                CloseDialogs();
                await ReloadAsync();
            }
            else
            {
                _dialogError = result.Error;
            }
        }
        finally
        {
            _value = _confirm = null;
            _busy = false;
        }
    }

    private async Task SaveDescriptionAsync()
    {
        if (_target is null)
        {
            return;
        }

        _busy = true;
        try
        {
            if (Toasts.FromResult(await Secrets.UpdateDescriptionAsync(_target.Name, _description), "Description saved"))
            {
                CloseDialogs();
                await ReloadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_target is not null && Toasts.FromResult(await Secrets.DeleteAsync(_target.Name), "Secret deleted"))
        {
            _target = null;
            await ReloadAsync();
        }
    }
}
