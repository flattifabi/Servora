@* Date-time input that edits a UTC timestamp (planning windows are always shown and entered in UTC). *@

<input type="datetime-local" class="input" value="@Text" disabled="@Disabled" step="60" @onchange="ChangedAsync" />

@code {
    /// <summary>Gets or sets the UTC value.</summary>
    [Parameter] public DateTimeOffset? Value { get; set; }

    /// <summary>Raised when the value changes.</summary>
    [Parameter] public EventCallback<DateTimeOffset?> ValueChanged { get; set; }

    /// <summary>Gets or sets a value indicating whether the input is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    private string Text => Value?.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;

    private async Task ChangedAsync(ChangeEventArgs e)
    {
        var text = e.Value?.ToString();
        DateTimeOffset? value = DateTime.TryParse(text, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var parsed)
            ? new DateTimeOffset(DateTime.SpecifyKind(parsed, DateTimeKind.Utc))
            : null;
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
