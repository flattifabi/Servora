@* Grouped vertical bar chart (or horizontal with Horizontal=true) with rounded bars and legend. *@
@using System.Globalization
<div>
    @if (Horizontal)
    {
        <div class="stack" style="gap:12px">
            @for (var i = 0; i < Labels.Count; i++)
            {
                var value = Series.Count > 0 && i < Series[0].Values.Count ? Series[0].Values[i] : 0;
                <div>
                    <div class="flex justify-between small mb-2"><span class="muted">@Labels[i]</span><b>@value.ToString(ValueFormat, CultureInfo.CurrentCulture)</b></div>
                    <div class="progress"><span style="width:@F(Max <= 0 ? 0 : value / Max * 100)%;background:@(Series.Count > 0 ? Series[0].Color ?? ChartPalette.At(i) : ChartPalette.At(i))"></span></div>
                </div>
            }
        </div>
    }
    else
    {
        <svg class="chart" viewBox="0 0 800 @Height" style="height:@(Height)px">
            @for (var g = 0; g <= 4; g++)
            {
                var y = Top + (PlotHeight * g / 4);
                <line class="grid-line" x1="@Left" x2="788" y1="@F(y)" y2="@F(y)" stroke-dasharray="@(g == 4 ? null : "3 4")" />
                <SvgText X="@(Left - 8)" Y="@F(y + 4)" Anchor="end" Text="@((Max - (Max * g / 4)).ToString(ValueFormat, CultureInfo.CurrentCulture))" />
            }
            @for (var i = 0; i < Labels.Count; i++)
            {
                var groupX = Left + (i * GroupWidth);
                var barWidth = Math.Min(28, (GroupWidth * 0.7) / Math.Max(1, Series.Count));
                var offset = (GroupWidth - (barWidth * Series.Count)) / 2;
                @for (var s = 0; s < Series.Count; s++)
                {
                    var value = i < Series[s].Values.Count ? Series[s].Values[i] : 0;
                    var h = Max <= 0 ? 0 : value / Max * PlotHeight;
                    <rect class="bar" x="@F(groupX + offset + (s * barWidth))" y="@F(Top + PlotHeight - h)" width="@F(barWidth - 3)" height="@F(Math.Max(h, 0))" rx="4" fill="@(Series[s].Color ?? ChartPalette.At(s))">
                        <title>@Series[s].Name · @Labels[i]: @value.ToString(ValueFormat, CultureInfo.CurrentCulture)</title>
                    </rect>
                }
                <SvgText X="@F(groupX + (GroupWidth / 2))" Y="@(Height - 6)" Anchor="middle" Text="@Labels[i]" />
            }
        </svg>
        @if (Series.Count > 1)
        {
            <div class="chart-legend">
                @for (var s = 0; s < Series.Count; s++)
                {
                    <span><span class="swatch" style="background:@(Series[s].Color ?? ChartPalette.At(s))"></span>@Series[s].Name</span>
                }
            </div>
        }
    }
</div>

@code {
    private const double Left = 44;
    private const double Top = 10;
    private const double Bottom = 26;

    /// <summary>Gets or sets the category labels.</summary>
    [Parameter] public IReadOnlyList<string> Labels { get; set; } = [];

    /// <summary>Gets or sets the series.</summary>
    [Parameter] public IReadOnlyList<ChartSeries> Series { get; set; } = [];

    /// <summary>Gets or sets the chart height in pixels (vertical mode).</summary>
    [Parameter] public int Height { get; set; } = 240;

    /// <summary>Gets or sets a value indicating whether bars are horizontal (single series, progress style).</summary>
    [Parameter] public bool Horizontal { get; set; }

    /// <summary>Gets or sets the value format.</summary>
    [Parameter] public string ValueFormat { get; set; } = "0.#";

    private double PlotHeight => Height - Top - Bottom;

    private double GroupWidth => Labels.Count == 0 ? 0 : (788 - Left) / Labels.Count;

    private double Max
    {
        get
        {
            var max = Series.SelectMany(s => s.Values).DefaultIfEmpty(0).Max();
            if (max <= 0)
            {
                return 1;
            }

            var magnitude = Math.Pow(10, Math.Floor(Math.Log10(max)));
            return Math.Ceiling(max / magnitude * 1.1) * magnitude;
        }
    }

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
}
